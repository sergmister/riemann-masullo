/-! # Printed assertions in the §10.3 proofs about the spectral constructions of §10.2 -/

@[expose] public noncomputable section

open Function MeasureTheory NumberField Set
open scoped NNReal

namespace RiemannMasullo

set_option quotPrecheck false

attribute [local instance] instIdeleClassMeasurableSpaceSec1 instIdeleClassBorelSpaceSec1
  instIdeleClassT2Sec1 instIdeleClassLocallyCompactSec1 instIdeleClassSecondCountableSec1
  instIdeleClassHaarMeasureSec1

local notation "C𝔽(" F ")" => IdeleClassGroup (𝓞 F) F
local notation "C₁(" F ")" => (ideleClassNorm F).ker
local notation "m𝔽(" F ")" =>
  (⟨ideleClassNorm F, (isProperMap_ideleClassNorm F).continuous⟩ : C𝔽(F) →ₜ* ℝ≥0ˣ)
local notation "shift(" b ", " t ")" => ((b : ℝ) : ℂ) + (t : ℂ) * Complex.I
local notation "orderAt(" χ ", " z ")" => meromorphicOrderAt (continuedCompletedHeckeL χ) z

local instance instDualMeasurableSpaceSec2SpectralProofPrinted
    (F : Type) [Field F] [NumberField F] : MeasurableSpace (PontryaginDual C𝔽(F)) := borel _

/-- Paper: Theorem 10.3.1.1, (10.3.1.15)–(16), p. 450.
As printed: the dual of the projected band is generated by the listed jets. The assertion
below is the inclusion of their order-zero members in the adjoint range. A finite selection
is given by its active norm-one characters and a nonempty set of selected ordinates in each.
See `spectralLineIsotype_bandProjections` for the inverse lift in symmetric bands and
`spectralConvolutionFiniteSum` for the use of the jets directly in §10.3. See ERRATA F179. -/
def Printed.spectralLineBandAdjoint_contains_selectedEvaluations : Prop :=
  ∀ (F : Type) [Field F] [NumberField F]
    (χ : PontryaginDual C₁(F) → PontryaginDual C𝔽(F)), IsSpectralBasepointChoice χ →
    ∀ (a s : ℝ) (hs : 1 < s) (K : Finset (PontryaginDual C₁(F)))
      (T : (ω : K) → Finset ℝ) (hT : ∀ ω, (T ω).Nonempty) (ε : K → ℝ),
      let lo (ω : K) := (T ω).min' (hT ω) - ε ω
      let hi (ω : K) := (T ω).max' (hT ω) + ε ω
      (∀ ω, 0 < ε ω ∧
        Icc (lo ω) (hi ω) ∩ {t | 0 < orderAt(χ ω.val, shift(a, t))} = (T ω : Set ℝ)) →
      let μ := ideleClassTamagawaMeasure F
      ∀ (ν : Measure (PontryaginDual C𝔽(F))) (hν : IsLCAPlancherelMeasure μ ν),
        let band := ⋃ ω : K, modulatedFrequencyBand m𝔽(F) (χ ω.val) (lo ω) (hi ω)
        let U := (lcaFourier_unitary μ ν hν).exists.choose
        let W := CompactIntervalSobolev μ (fun g ↦ Real.log ((ideleClassNorm F g).val : ℝ)) 0 0 s
        let hI := le_rfl (a := (0 : ℝ))
        let hs₀ := le_of_lt (zero_lt_one.trans hs)
        let Θ := globalThetaSobolev F a hI hs₀
        let Q := spectralSobolevQuotient F a hI hs₀
        let B : Set Q := {q | ∃ f : W, q = Θ.mkQ f ∧ ∃ u : Lp ℂ 2 μ,
          (u : C𝔽(F) → ℂ) =ᵐ[μ] (f : C𝔽(F) → ℂ) ∧
          ∀ᵐ ψ ∂ν, ψ ∉ band → U u ψ = 0}
        ∀ P : Q →L[ℂ] Q, range P = closure B →
          (∀ q y, y ∈ closure B → ‖q - P q‖ ≤ ‖q - y‖) →
          ∀ (ω : K) (t : ℝ), t ∈ T ω →
            ∃ d : StrongDual ℂ Q, d ∈ range (P.precomp ℂ) ∧
              ∀ f : W,
                let integrand := fun g ↦ f g * spectralZeroJet (χ ω.val) 0 t 0 g
                Integrable integrand μ ∧ d (Θ.mkQ f) = ∫ g, integrand g ∂μ

/-- Paper: Theorem 10.3.1.1, (10.3.1.15)–(16), p. 450.
Take the rational field, the trivial base character, a = 1/2 and s = 2. Select only
the first positive critical-line zeta ordinate t and take a small isolating interval about t.
The zeroth jet pairs with the Fourier value at −t, so it vanishes on the band image and
its closure. The jet is nonzero, as is seen by pairing it with a nonnegative smooth radial
bump of positive integral times exp(−it log |g|). Every element of the adjoint range of the
orthogonal projection that annihilates its image is zero. -/
theorem Printed.spectralLineBandAdjoint_contains_selectedEvaluations_false :
    ¬ Printed.spectralLineBandAdjoint_contains_selectedEvaluations := by sorry

/-- Paper: Theorem 10.3.2.1, proof before (10.3.2.6), p. 454.
As printed: for every strip of positive half-width, the truncated multiplicities attained
at strip zeros over the chosen unitary base points are unbounded. At the boundary the
paper uses the floor cutoff. See `spectralStripMultiplicity` and ERRATA F184. -/
def Printed.spectralStripMultiplicity_unbounded : Prop :=
  ∀ (F : Type) [Field F] [NumberField F]
    (χ : PontryaginDual C₁(F) → PontryaginDual C𝔽(F)), IsSpectralBasepointChoice χ →
    ∀ (a α s : ℝ), 0 < α → 1 < s → ∀ M : ℕ,
      ∃ (ω : PontryaginDual C₁(F)) (b t : ℝ),
        b ∈ Icc (-α) α ∧ 0 < orderAt(χ ω, shift(a + b, t)) ∧
        let N := (orderAt(χ ω, shift(a + b, t))).untop₀.toNat
        M < if b = -α ∨ b = α then min N (Nat.floor ((s - 1) / 2 + 1)) else N

/-- Paper: Theorem 10.3.2.1, proof before (10.3.2.6), p. 454.
Take the rational field, a = 2, α = 1/4 and s = 2. The absolutely convergent Euler product
and the nonvanishing archimedean factors give no zeros for any unitary lift in the strip
7/4 ≤ Re z ≤ 9/4. The existential claim already fails at M = 0. -/
theorem Printed.spectralStripMultiplicity_unbounded_false :
    ¬ Printed.spectralStripMultiplicity_unbounded := by
  intro hall
  obtain ⟨χ, hχ⟩ := exists_spectralBasepointChoice ℚ
  obtain ⟨ω, b, t, hb, hpos, -⟩ := hall ℚ χ hχ 2 (1 / 4) 2 (by norm_num) (by norm_num) 0
  let z := shift((2 : ℝ) + b, t)
  have hz : 1 < z.re := by
    have := hb.1
    norm_num [z]
    linarith
  have hval : continuedCompletedHeckeL (χ ω) z ≠ 0 := by
    rw [show continuedCompletedHeckeL (χ ω) z = completedHeckeL (χ ω) ⟨z, hz⟩ from
      (continuedCompletedHeckeL_spec (χ ω)).2 ⟨z, hz⟩]
    exact mul_ne_zero (heckeGammaFactor_ne_zero_of_re_pos (χ ω) (zero_lt_one.trans hz))
      (finiteHeckeL_ne_zero_of_one_lt_re (χ ω) ⟨z, hz⟩)
  have horder := ((continuedCompletedHeckeL_spec (χ ω)).1
    (mem_univ z)).meromorphicOrderAt_eq_zero_iff.mpr hval
  simp only [z] at horder
  rw [horder] at hpos
  exact lt_irrefl _ hpos

end RiemannMasullo
