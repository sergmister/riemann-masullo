module

public import RiemannMasullo.Ch10_TraceSpectral.Sec1
public import RiemannMasullo.AppB_AnalyticNT.Sec4b

/-!
# Finite conductor of the angular profiles of a Bruhat test

Definition D.1.5.1, p. 760, makes a good period subgroup compact with compactly
generated annihilator. Restriction to the norm-one group takes a compact
generating set to finitely many angular characters. We deduce that the local
conductor exponents of these generators, as in §3.3.1, p. 133, bound the
exponents of every contributing character. This gives one bound for the finite
conductor term in (B.4.2.3), p. 614, throughout the angular expansion of a test.
-/

@[expose] public noncomputable section

open Function Filter IsDedekindDomain MeasureTheory NumberField Set Topology
open scoped NNReal NumberField.AdeleRing

namespace RiemannMasullo

set_option quotPrecheck false

section CompactRestriction

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [LocallyCompactSpace G] (K : Subgroup G)

local notation "res" => (PontryaginDual.map (⟨K.subtype, continuous_subtype_val⟩ : K →ₜ* G))

/-- Restriction of a compactly generated group of characters to a compact subgroup
is generated by the restrictions of finitely many of the original characters. -/
private theorem finite_generators_of_compact_restriction [CompactSpace K]
    (A : Subgroup (PontryaginDual G)) (hA : IsCompactlyGeneratedGroup A) :
    ∃ S : Finset (PontryaginDual G), ∀ ψ ∈ A,
      res ψ ∈ Subgroup.closure (res '' (S : Set (PontryaginDual G))) := by
  classical
  obtain ⟨C, _, hC, hgen⟩ := hA
  let f : A →ₜ* PontryaginDual K := (res).comp ⟨A.subtype, continuous_subtype_val⟩
  let D := f '' C
  have hD : D.Finite := (hC.image f.continuous).finite_of_discrete
  let : Fintype D := hD.fintype
  let lift (z : D) : A := z.property.choose
  have hlift (z : D) : f (lift z) = z.val := z.property.choose_spec.2
  let S := Finset.univ.image (fun z : D ↦ (lift z).val)
  let B := Subgroup.closure (res '' (S : Set (PontryaginDual G)))
  have htop : ⊤ ≤ B.comap f.toMonoidHom := hgen ▸ (Subgroup.closure_le _).mpr (by
    intro c hc
    let z : D := ⟨f c, ⟨c, hc, rfl⟩⟩
    change f c ∈ B
    apply Subgroup.subset_closure
    refine ⟨(lift z).val, ?_, hlift z⟩
    exact Finset.mem_image.mpr ⟨z, Finset.mem_univ _, rfl⟩)
  exact ⟨S, fun ψ hψ ↦ htop (Subgroup.mem_top (x := (⟨ψ, hψ⟩ : A)))⟩

variable [MeasurableSpace K] [BorelSpace K] (μ : Measure K) [μ.IsHaarMeasure]

/-- Translating a nonzero Haar coefficient by a period shows that its character
is trivial on every period contained in the integration subgroup. -/
private theorem nonzero_angular_profile_mem_annihilator (H : Subgroup G) (hHK : H ≤ K)
    (φ : G → ℂ) (hφ : ∀ h : H, ∀ x, φ (h.val * x) = φ x) (ψ : PontryaginDual G) (g : G)
    (hg : (∫ k : K, φ (k.val * g) * (ψ (k.val * g) : ℂ) ∂μ) ≠ 0) :
    ψ ∈ lcaAnnihilator H := by
  rw [mem_lcaAnnihilator_iff]
  intro h
  let k : K := ⟨h.val, hHK h.property⟩
  let q (y : K) := φ (y.val * g) * (ψ (y.val * g) : ℂ)
  have hmul (y : K) : q (k * y) = (ψ h.val : ℂ) * q y := by
    change φ ((h.val * y.val) * g) * (ψ ((h.val * y.val) * g) : ℂ) = _
    rw [mul_assoc, hφ h, map_mul, Circle.coe_mul]
    dsimp only [q]
    ring
  have he := integral_mul_left_eq_self (μ := μ) q k
  simp_rw [hmul, integral_const_mul] at he
  exact Circle.ext ((mul_eq_right₀ hg).mp he)

/-- For a compact subgroup containing every compact period subgroup, the active
angular characters of a Bruhat test belong to a finitely generated subgroup of
its dual. The generators are restrictions of global characters. -/
theorem IsBruhatContDiff.exists_finite_angular_generators [CompactSpace K]
    {φ : G → ℂ} (hφ : IsBruhatContDiff 0 φ)
    (hK : ∀ H : Subgroup G, IsCompact (H : Set G) → H ≤ K) :
    ∃ S : Finset (PontryaginDual G), ∀ (ψ : PontryaginDual G) (g : G),
      (∫ k : K, φ (k.val * g) * (ψ (k.val * g) : ℂ) ∂μ) ≠ 0 →
        res ψ ∈ Subgroup.closure (res '' (S : Set (PontryaginDual G))) := by
  obtain ⟨H, hH, hper, _⟩ := hφ
  obtain ⟨S, hS⟩ := finite_generators_of_compact_restriction K (lcaAnnihilator H) hH.2.2
  exact ⟨S, fun ψ g hg ↦ hS ψ (nonzero_angular_profile_mem_annihilator
    K μ H (hK H hH.isCompact) φ hper ψ g hg)⟩

end CompactRestriction

section FiniteConductor

variable {F : Type*} [Field F] [NumberField F]

attribute [local instance] instIdeleClassMeasurableSpaceSec1 instIdeleClassBorelSpaceSec1
  instIdeleClassT2Sec1 instIdeleClassLocallyCompactSec1 instIdeleClassSecondCountableSec1

local notation "V" => HeightOneSpectrum (𝓞 F)
local notation "C𝔽" => IdeleClassGroup (𝓞 F) F
local notation "K𝔽" => (ideleClassNorm F).ker
local notation "res₁" =>
  (PontryaginDual.map (⟨(ideleClassNorm F).ker.subtype, continuous_subtype_val⟩ : K𝔽 →ₜ* C𝔽))
local notation "q(" v ")" => ((HeightOneSpectrum.asIdeal v).absNorm : ℝ)
local notation "ι(" v ", " u ")" => IdeleClassGroup.ofAdicCompletion (𝓞 F) F v u
local notation "levels(" ψ ", " v ")" =>
  ({n : ℕ | ∀ u : (HeightOneSpectrum.adicCompletion F v)ˣ, ‖u.val‖ = 1 →
    ‖u.val - 1‖ ≤ q(v) ^ (-(n : ℤ)) → ψ (ι(v, u)) = 1} : Set ℕ)
local notation "profile(" μ ", " φ ", " ψ ", " g ")" =>
  (∫ k : K𝔽, (φ : BruhatCompactSupport C𝔽).val (k.val * g) * (ψ (k.val * g) : ℂ) ∂μ)

/-- A single finitely supported tuple of exponents bounds the local levels of the
subgroup generated by finitely many Hecke characters on the norm-one classes. -/
private theorem finite_conductor_of_generators (S : Finset (PontryaginDual C𝔽)) :
    ∃ N : V → ℕ, (Function.support N).Finite ∧
      ∀ ψ : PontryaginDual C𝔽, res₁ ψ ∈ Subgroup.closure (res₁ '' (S : Set _)) →
        ∀ v, N v ∈ levels(ψ, v) := by
  classical
  choose n hn hleast using fun η : PontryaginDual C𝔽 ↦ exists_heckeConductorExponents η
  let N (v : V) := S.sup (fun η ↦ n η v)
  let T := S.biUnion (fun η ↦ (hn η).toFinset)
  have hN : (Function.support N).Finite := T.finite_toSet.subset (by
    intro v hv
    by_contra h
    apply hv
    apply Nat.eq_zero_of_le_zero
    apply Finset.sup_le
    intro η hη
    apply Nat.le_zero.mpr
    by_contra hvη
    exact h (Finset.mem_biUnion.mpr ⟨η, hη, (hn η).mem_toFinset.mpr hvη⟩))
  refine ⟨N, hN, ?_⟩
  intro ψ hψ v u hu hclose
  have hx : ι(v, u) ∈ K𝔽 := by
    rw [MonoidHom.mem_ker, ideleClassNorm_ofAdicCompletion]
    apply Units.ext
    apply NNReal.coe_injective
    exact hu
  let x : K𝔽 := ⟨ι(v, u), hx⟩
  let eval : PontryaginDual K𝔽 →* Circle :=
    { toFun := fun η ↦ η x
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }
  let B := eval.ker
  have hgen : res₁ '' (S : Set _) ⊆ B := by
    rintro _ ⟨η, hη, rfl⟩
    have hnη : n η v ≤ N v := Finset.le_sup (f := fun η ↦ n η v) hη
    have hq : 1 ≤ q(v) := by exact_mod_cast (NumberField.HeightOneSpectrum.one_lt_absNorm v).le
    have hpow : q(v) ^ (-(N v : ℤ)) ≤ q(v) ^ (-(n η v : ℤ)) :=
      zpow_le_zpow_right₀ hq (neg_le_neg (by exact_mod_cast hnη))
    exact (hleast η v).1 u hu (hclose.trans hpow)
  exact ((Subgroup.closure_le B).mpr hgen) hψ

/-- For each compact Bruhat test on the idele classes of a number field there is
one finite conductor level for all of its nonzero angular Haar profiles, uniformly
over the radial translate. At a finite place of residue cardinality `q`, every
contributing character kills all units with `‖u - 1‖ ≤ q ^ (-N)`, and `N` vanishes
outside a finite set of places. The filtration is the one in §3.3.1 and (B.4.2.3), p. 614. -/
theorem bruhatCompactSupport_angular_conductor_level (φ : BruhatCompactSupport C𝔽)
    (μ : Measure K𝔽) [μ.IsHaarMeasure] :
    ∃ N : V → ℕ, (Function.support N).Finite ∧
      ∀ (ψ : PontryaginDual C𝔽) (g : C𝔽), profile(μ, φ, ψ, g) ≠ 0 →
        ∀ v, N v ∈ levels(ψ, v) := by
  let : CompactSpace K𝔽 := (ideleClassGroup_finiteness F).2.1
  let m : C𝔽 →ₜ* ℝ≥0ˣ := ⟨ideleClassNorm F, (isProperMap_ideleClassNorm F).continuous⟩
  have hφ := (mem_bruhatSmoothSubmodule_iff _).mp φ.property.1 0
  obtain ⟨S, hS⟩ := hφ.exists_finite_angular_generators K𝔽 μ
    (fun H hH ↦ compactSubgroup_le_modulation_ker m H hH)
  obtain ⟨N, hN, hlevels⟩ := finite_conductor_of_generators S
  exact ⟨N, hN, fun ψ g hg ↦ hlevels ψ (hS ψ g hg)⟩

/-- The logarithm of the discriminant–finite-conductor product is bounded above
on every nonzero angular profile of a fixed compact Bruhat test. The logarithm
uses precisely the finite local exponents in `heckeLogDiscriminantConductor`. -/
theorem bruhatCompactSupport_bounded_angular_logConductor (φ : BruhatCompactSupport C𝔽)
    (μ : Measure K𝔽) [μ.IsHaarMeasure] :
    ∃ C : ℝ, ∀ (ψ : PontryaginDual C𝔽) (g : C𝔽), profile(μ, φ, ψ, g) ≠ 0 →
      heckeLogDiscriminantConductor ψ ≤ C := by
  obtain ⟨N, hN, hlevel⟩ := bruhatCompactSupport_angular_conductor_level φ μ
  refine ⟨Real.log (Int.natAbs (NumberField.discr F)) +
    ∑ᶠ v : V, Real.log q(v) * (N v : ℝ), ?_⟩
  intro ψ g hg
  let n (v : V) := sInf (levels(ψ, v))
  have hle (v : V) : n v ≤ N v := Nat.sInf_le (hlevel ψ g hg v)
  have support_weight (a : V → ℕ) (h : ∀ v, a v ≤ N v) :
      (Function.support (fun v ↦ Real.log q(v) * (a v : ℝ))).Finite := by
    apply hN.subset
    intro v hv hn
    have ha : a v = 0 := Nat.eq_zero_of_le_zero ((h v).trans_eq hn)
    exact hv (by simp [ha])
  unfold heckeLogDiscriminantConductor
  apply add_le_add_right
  apply finsum_le_finsum (support_weight n hle) (support_weight N (fun _ ↦ le_rfl))
  intro v
  exact mul_le_mul_of_nonneg_left (by exact_mod_cast hle v) (Real.log_nonneg (by
    exact_mod_cast (NumberField.HeightOneSpectrum.one_lt_absNorm v).le))

end FiniteConductor
end RiemannMasullo
